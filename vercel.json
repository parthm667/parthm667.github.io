{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/resume-picker.mjs": {
      "includeFiles": "server/data/resumes.enc.json",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/resume-picker",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/vigil",
      "destination": "https://github.com/parthm667/vigil",
      "permanent": false
    },
    {
      "source": "/clarify",
      "destination": "https://github.com/parthm667/clarify",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/nj-hin/api/(.*)",
      "destination": "https://hin-api.mhaske.com/api/$1"
    },
    {
      "source": "/nj-hin",
      "destination": "https://hin.mhaske.com/nj-hin/"
    },
    {
      "source": "/nj-hin/(.*)",
      "destination": "https://hin.mhaske.com/nj-hin/$1"
    },
    {
      "source": "/((?!api/|nj-hin).*)",
      "destination": "/index.html"
    }
  ]
}
